{
  "name": "ubatssim",
  "private": true,
  "version": "0.1.0",
  "description": "Realistisk ubåtssimulator i webbläsaren",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude 'tests/long/**'",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "bench": "vitest run --config scripts/bench.config.ts --silent=false",
    "update-determinism": "UPDATE_DETERMINISM=1 vitest run tests/long/determinism.long.test.ts --silent=false",
    "test:e2e": "npm run build && playwright test",
    "update-durations": "node scripts/update-durations.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
